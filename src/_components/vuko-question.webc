<section webc:root class="card">
  <h3 :id="label" @text="question"></h3>
  <slot></slot>
  <button type="button" class="clear">
    <span>Clear answer</span>
    <svg-sprite @icon="trash_can"></svg-sprite>
  </button>
</section>

<style webc:scoped>
  :host.card {
    position: relative;

    h3 {
      font-size: 1.2rem;
      margin-bottom: 1rem;
    }

    input[type="radio"],
    input[type="checkbox"] {
      transform: scale(1.6);
    }

    .clear {
      position: absolute;
      display: none;
      align-items: center;
      bottom: 0;
      right: 0;
      gap: .5rem;
      cursor: pointer;
      background: var(--vuko-card-color);
      border: none;
      color: var(--vuko-accent-color);
      border-radius: var(--vuko-card-border-radius) 0;
      padding: .8rem;

      svg {
        height: 1rem;
        aspect-ratio: 1;
      }
    }

    .clear:focus, .clear:hover {
      background: hsl(from var(--vuko-card-color) h s calc(l - 4));
    }
  }

  :host::after {
    content: "";
    position: absolute;
    height: calc(100% + 16px);
    width: calc(100% + 16px);
    inset: -8px;
    background-image:
      url(/assets/flower-2.svg),
      url(/assets/flower-1.svg);
    background-repeat: no-repeat;
    background-size: 6rem, 4rem;
    background-position:
      top right,
      bottom left;
    pointer-events: none;
  }
</style>


<script>
  class VukoQuestion extends HTMLElement {
    /** @type {HTMLButtonElement=} */
    #clearButton;
    /** @type {NodeListOf<HTMLInputElement|HTMLTextAreaElement>=} */
    #formFields;

    connectedCallback() {
      this.#clearButton = this.querySelector('.clear');
      this.#formFields = this.querySelectorAll('input, textarea');

      this.#clearButton.addEventListener('click', (event) => {
        this.#formFields.forEach(elem => {
          if (elem.nodeName === 'TEXTAREA') {
            elem.value = '';
            return;
          }

          switch (elem.type) {
            case 'radio':
            case 'checkbox':
              elem.checked = false;
              break;
            case 'text':
            case 'email':
              elem.value = '';
              break;
            default:
              // Do nothing!
          }
        });
      });

      this.#clearButton.style.display = 'flex';
    }
  }

  customElements.define('vuko-question', VukoQuestion);
</script>
