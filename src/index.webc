<!DOCTYPE html>
<html lang="en">

<head>
  <template webc:type="11ty" 11ty:type="njk">
  {% include "head.njk" %}
  </template>
  <script :src="getBundleFileUrl('js')" webc:keep defer></script>
  <link rel="preload" href="/assets/header.png" as="image"
    fetchpriority="high" />
  <script webc:keep async src="/lib/altcha.js" type="module"></script>
</head>

<body>
  <main>
    <header>
      <h1>
        <picture>
          <source srcset="/assets/title-static.gif"
            media="(prefers-reduced-motion: reduce)" />
          <img src="/assets/title.gif"
            alt="User Behavior in Design: A Survey" />
        </picture>
      </h1>
    </header>
    <vuko-welcome></vuko-welcome>
    <form :action="`${config.apiBaseUrl}/submit`" method="post">
      <h2 class="section-heading">About You</h2>
      <vuko-question @question="How old are you?">
        <vuko-single-choice @name="ageBand" :@answers="[
            'Under 25 years old',
            '25-34 years old',
            '35-44 years old',
            '45-54 years old',
            '55-64 years old',
            '65 years or older',
            'Prefer not to say',
          ]"></vuko-single-choice>
      </vuko-question>
      <vuko-question @question="How would you describe your technical knowledge? (select the option that best describes you)">
        <vuko-single-choice @name="techExpertise" :@answers="[
            'I have very little technical knowledge',
            'I am comfortable using everyday technology',
            'I have a good understanding of technology',
            'I have programming or software development experience',
            'I work professionally in IT or another technical field',
            ]"></vuko-single-choice>
      </vuko-question>
      <vuko-question @question="How often do you visit SVGO.dev?">
        <vuko-single-choice @name="visitFrequency" :@answers="[
            'This is my first time visiting',
            'I have visited SVGO.dev a few times before',
            'I am a regular user',
            ]"></vuko-single-choice>
      </vuko-question>
      <h2 class="section-heading">The SVGO Cookie Banner</h2>
      <vuko-question @question="How did the cookie banner make you feel?">
        <vuko-multiple-choice @name="bannerEmotion" :@answers="[
            'Welcomed',
            'Neutral',
            'Annoyed',
            'Amused',
            'Surprised',
          ]" :@other="true"></vuko-multiple-choice>
      </vuko-question>
      <vuko-question @question="How would you describe your first impression of SVGO's cookie banner?">
        <vuko-multiple-choice @name="bannerImpression" :@answers="[
            'Professional',
            'Annoying',
            'Friendly',
            'Generic',
            'Confusing',
            'Trustworthy',
            'Distracting',
            'Fits the website',
            'Does not fit the website',
            'Neutral',
          ]" :@other="true"></vuko-multiple-choice>
      </vuko-question>
      <vuko-question @question="How visually appealing did you find the cookie banner?">
        <vuko-likert @name="bannerAppeal" :@labels="[
          'Not appealing at all',
          'Slightly appealing',
          'Moderately appealing',
          'Very appealing',
          'Extremely appealing',
        ]">
        </vuko-likert>
      </vuko-question>
      <vuko-question @question="How visually complex did the cookie banner feel to you?">
        <vuko-likert @name="bannerComplexity" :@labels="[
          'Not complex at all',
          'Slightly complex',
          'Moderately complex',
          'Very complex',
          'Extremely complex',
        ]">
        </vuko-likert>
      </vuko-question>
      <vuko-question @question="How easy was it to understand the cookie banner?">
        <vuko-likert @name="bannerUnderstanding" :@labels="[
          'Very difficult',
          'Somewhat difficult',
          'Neither easy nor difficult',
          'Somewhat easy',
          'Very easy',
        ]"></vuko-likert>
      </vuko-question>
      <vuko-question @question="How did the cookie banner affect your trust in the SVGO.dev website?">
        <vuko-likert @name="bannerTrustEffect" :@labels="[
          'Significantly decreased my trust',
          'Slightly decreased my trust',
          'No effect',
          'Slightly increased my trust',
          'Significantly increased my trust',
        ]"></vuko-likert>
      </vuko-question>
      <vuko-question @question="Do you believe that the cookie banner you saw on the SVGO website follows privacy regulations?">
        <vuko-single-choice @name="bannerCompliance" :@answers="[
            'Yes',
            'No',
            'I am not sure',
            ]"></vuko-single-choice>
      </vuko-question>
       <vuko-question @question="What influenced your choice to accept or reject cookies on the SVGO website?">
        <vuko-multiple-choice @name="bannerDecisionFactors" :@answers="[
            'Design/appearance of the cookie banner',
            'Trust in the website',
            'The website\'s brand/visual identity',
            'Clear explanation of what cookies are used for',
            'Habit (I usually accept/reject without thought)',
            'Preservation of privacy',
            'I just wanted the banner to go away',
          ]" :@other="true"></vuko-multiple-choice>
      </vuko-question>
      <vuko-question @question="How integrated did the cookie banner feel with the website?">
        <vuko-likert @name="bannerIntegration" :@labels="[
          'Completely separate from the website',
          'Mostly separate',
          'Neither separate nor integrated',
          'Mostly integrated',
          'Fully integrated with the website',
        ]"></vuko-likert>
      </vuko-question>
      <h2 class="section-heading">The SVGO.dev Website</h2>
      <vuko-question @question="What is your first impression of SVGO.dev?">
        <vuko-likert @name="websiteImpression" :@labels="[
          'Very negative',
          'Somewhat negative',
          'Neutral',
          'Somewhat positive',
          'Very positive',
        ]">
        </vuko-likert>
      </vuko-question>
      <vuko-question @question="How trustworthy does the SVGO.dev website feel to you?">
        <vuko-likert @name="websiteTrust" :@labels="[
          'Not trustworthy at all',
          'Slightly trustworthy',
          'Moderately trustworthy',
          'Very trustworthy',
          'Extremely trustworthy',
        ]"></vuko-likert>
      </vuko-question>
      <vuko-question @question="Which words would you use to describe the tone of the SVGO.dev website?">
        <vuko-multiple-choice @name="websiteTone" :@answers="[
            'Professional',
            'Cold',
            'Friendly',
            'Generic',
            'Modern',
            'Corporate',
            'Playful',
            'Technical',
            'Welcoming',
            'Unique',
          ]" :@other="true"></vuko-multiple-choice>
      </vuko-question>
      <h2 class="section-heading">General Questions</h2>
      <vuko-question @question="In general, how do you feel when websites show you cookie consent banners/popups?">
        <vuko-likert @name="generalBannerAttitude" :@labels="[
          'Very negative',
          'Somewhat negative',
          'Neutral',
          'Somewhat positive',
          'Very positive',
        ]"></vuko-likert>
      </vuko-question>
      <vuko-question @question="How much do cookie banners typically affect your first impression of a website?">
        <vuko-likert @name="generalBannerImpact" :@labels="[
          'Not at all',
          'Slightly',
          'Moderately',
          'Quite a bit',
          'Very much',
        ]"></vuko-likert>
      </vuko-question>
      <vuko-question @question="Do you use any tools that automate responding to cookie banners?">
        <vuko-multiple-choice @name="blockingTools" :@answers="[
              'Brave browser (built-in blocking)',
              'uBlock Origin or similar ad blocker',
              '&quot;I don\'t care about cookies&quot; / &quot;I still don\'t care about cookies&quot; browser extension',
              'Consent-O-Matic',
              'I don\'t use any such tools'
            ]" :@other="true"></vuko-multiple-choice>
      </vuko-question>
      <h2 class="section-heading">One Last Thing</h2>
      <vuko-question @label="openFeedback-label" @question="Anything else you'd like to share?">
        <textarea name="openFeedback" placeholder="Answer text"
          aria-labelledby="openFeedback-label" maxlength="1024"></textarea>
      </vuko-question>
      <vuko-question @label="email-label" @question="If you'd like to, leave your email below for a coupon code for a free sticker pack from my web shop.">
        <input name="email" placeholder="Email" type="email"
          aria-labelledby="email-label" maxlength="100" />
      </vuko-question>
      <section>
        <vuko-altcha-widget :@config="config"></vuko-altcha-widget>
        <vuko-submit></vuko-submit>
      </section>
    </form>
    <img class="peeper" src="/assets/peeper.png" alt="" />
  </main>
  <svg-filters></svg-filters>
</body>

</html>

<style>
  body {
    display: flex;
    justify-content: center;
    position: relative;
  }

  main {
    width: 100%;
    max-width: 760px;
    margin: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    container-type: inline-size;

    &::after {
      content: "";
      width: 60%;
      max-width: 396px;
      aspect-ratio: 0.75862069;

      @media (min-width: 1600px) {
        display: none;
      }
    }
  }

  .peeper {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 60%;
    max-width: 396px;
    max-height: 522px;

    @media (min-width: 1600px) {
      position: fixed;
    }
  }

  header {
    height: var(--vuko-header-height);
    width: 100%;
    border-radius: 1rem;
    background: no-repeat url("/assets/header.png") 43%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4px 15px var(--vuko-card-shadow);

    img {
      box-sizing: border-box;
      padding: 2rem;
      max-width: 100%;
      max-height: var(--vuko-header-height);
      filter: drop-shadow(0 6px 4px #3c0c014a);
    }
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-heading {
    text-align: center;
    font-family: "Scabber", var(--vuko-font);
    color: var(--vuko-text-color);
    font-size: 2.6em;
    font-weight: 500;
    filter: url(#thick-outline) drop-shadow(5px 5px 0.2em var(--vuko-card-shadow));
  }
</style>

<script>
  const { search } = window.location;
  const urlSearchParams = new URLSearchParams(search);
  const variant = urlSearchParams.get('utm_content');

  if (variant) {
    const form = /** @type {HTMLFormElement} */ (document.querySelector('form'));
    form.action += `?utm_content=${encodeURIComponent(variant)}`;
  }
</script>
