<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="Survey for cookie banner study conducted on SVGO.dev." />
  <meta property="og:image" :content="`${$data.config.baseUrl}/assets/opengraph.jpg`" />
  <link rel="icon" href="/assets/favicon.webp" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="760" />
  <meta property="og:image:height" content="250" />
  <link rel="stylesheet" href="../../global.css" />
  <link webc:keep :href="getBundleFileUrl('css')" rel="stylesheet">
  <script webc:keep async
    src="https://plausible.falco.fun/js/pa-cLPh3hvx5IzB08rR93-zj.js"></script>
  <script webc:keep>
    window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments) }, plausible.init = plausible.init || function (i) { plausible.o = i || {} };
    plausible.init()
  </script>
  <script webc:if="bundleScripts" webc:keep :src="getBundleFileUrl('js')" defer></script>
  <template webc:nokeep @raw="getBundle('html', 'meta')"></template>
</head>

<body>
  <template webc:nokeep @raw="content"></template>
</body>

</html>
