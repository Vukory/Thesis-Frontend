<section webc:root class="card">
  <h3 :id="label" @text="question"></h3>
  <slot></slot>
  <button type="button" class="clear">
    <span>Clear answer</span>
    <svg-sprite @icon="trash_can"></svg-sprite>
  </button>
  <button type="button" class="undo">
    <span>Undo</span>
    <svg-sprite @icon="arrow_counterclockwise"></svg-sprite>
  </button>
</section>

<style webc:scoped>
  :host.card {
    position: relative;

    h3 {
      font-size: 1.2rem;
      margin-bottom: 1rem;
    }

    input[type="radio"],
    input[type="checkbox"] {
      transform: scale(1.6);
    }

    button {
      position: absolute;
      display: none;
      align-items: center;
      bottom: 0;
      right: 0;
      gap: .5rem;
      cursor: pointer;
      background: var(--vuko-card-color);
      border: none;
      color: var(--vuko-accent-color);
      border-radius: var(--vuko-card-border-radius) 0;
      padding: .8rem;
      width: 10rem;
      justify-content: center;

      svg {
        height: 1rem;
        aspect-ratio: 1;
      }

      &:focus, &:hover {
        background: hsl(from var(--vuko-card-color) h s calc(l - 4));
      }

      &.active {
        display: flex;
      }
    }
  }

  :host::after {
    content: "";
    position: absolute;
    height: calc(100% + 16px);
    width: calc(100% + 16px);
    inset: -8px;
    background-image:
      url("/assets/flower-2.svg"),
      url("/assets/flower-1.svg");
    background-repeat: no-repeat;
    background-size: 6rem, 4rem;
    background-position:
      top right,
      bottom left;
    pointer-events: none;
  }
</style>


<script>
  class VukoQuestion extends HTMLElement {
    /** @type {NodeListOf<HTMLInputElement|HTMLElement>=} */
    #formFields;
    /** @type {HTMLButtonElement=} */
    #clearButton;
    /** @type {HTMLButtonElement=} */
    #undoButton;
    /** @type {Map<string, unknown>=} */
    #previousAnswers;

    connectedCallback() {
      this.#formFields = this.querySelectorAll('input, textarea');
      this.#clearButton = this.querySelector('.clear');
      this.#undoButton = this.querySelector('.undo');
      this.#clearButton.addEventListener('click', this.#onClearButtonClick);
      this.#undoButton.addEventListener('click', this.#onUndoButtonClick);

      for (const field of this.#formFields) {
        field.addEventListener('change', this.#onFormInput);
        field.addEventListener('input', this.#onFormInput);
      }

      this.#clearButton.classList.add('active');
    }

    disconnectedCallback() {
      this.#clearButton.removeEventListener('click', this.#onClearButtonClick);
      this.#undoButton.removeEventListener('click', this.#onUndoButtonClick);

      for (const field of this.#formFields) {
        field.removeEventListener('change', this.#onFormInput);
        field.removeEventListener('input', this.#onFormInput);
      }
    }

    #onClearButtonClick = () => {
      const answers = new Map();

      for (const field of this.#formFields) {
        if (field.nodeName === 'TEXTAREA' && field.value) {
          answers.set(field, field.value);
          field.value = '';
          continue;
        }

        switch (field.type) {
          case 'radio':
          case 'checkbox':
            if (field.checked) {
              answers.set(field, field.checked);
              field.checked = false;
            }
            break;
          case 'text':
          case 'email':
            if (field.value) {
              answers.set(field, field.value);
              field.value = '';
            }
            break;
          default:
            // Do nothing!
        }
      }

      if (answers.size === 0) {
        return;
      }

      this.#previousAnswers = answers;
      this.#clearButton.classList.remove('active');
      this.#undoButton.classList.add('active');
      this.#undoButton.focus();
    };

    #onUndoButtonClick = () => {
      for (const field of this.#formFields) {
        if (!this.#previousAnswers.has(field)) {
          continue;
        }

        const answer = this.#previousAnswers.get(field);

        if (field.nodeName === 'TEXTAREA') {
          field.value = answer;
          continue;
        }

        switch (field.type) {
          case 'radio':
          case 'checkbox':
            field.checked = answer;
            break;
          case 'text':
          case 'email':
            field.value = answer;
            break;
          default:
            // Do nothing!
        }
      }

      this.#previousAnswers = null;
      this.#undoButton.classList.remove('active');
      this.#clearButton.classList.add('active');
      this.#clearButton.focus();
    };

    #onFormInput = () => {
      if (this.#previousAnswers) {
        this.#previousAnswers = null;
        this.#undoButton.classList.remove('active');
        this.#clearButton.classList.add('active');
      }
    };
  }

  customElements.define('vuko-question', VukoQuestion);
</script>
